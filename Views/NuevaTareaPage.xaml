<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClimaApi.Views.NuevaTareaPage"
             Title="Nueva Tarea">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" />

            <Entry Placeholder="Título de la tarea" Text="{Binding Titulo}" FontSize="16" />
            <Editor Placeholder="Descripción detallada" Text="{Binding Descripcion}" HeightRequest="100" />

            <Frame BackgroundColor="#F0F0F0" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Geolocalización &amp; Clima" FontAttributes="Bold" />
                    <Label Text="{Binding EstadoClimaGPS}" TextColor="Gray" FontSize="12" />
                    <Button Text="Obtener GPS y Clima" Command="{Binding CapturarUbicacionYClimaCommand}" BackgroundColor="#2B0B98" TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Guardar Tarea" Command="{Binding GuardarTareaCommand}" BackgroundColor="#512BD4" TextColor="White" HeightRequest="50" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>